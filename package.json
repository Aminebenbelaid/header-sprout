{
  "name": "header-sprout",
  "version": "1.1.0",
  "description": "A friendly request and response header editor for Firefox and Chromium browsers.",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test tests/*.test.js",
    "build": "python3 scripts/build.py",
    "lint:firefox": "web-ext lint --source-dir dist/firefox --warnings-as-errors",
    "check": "npm test && npm run build && npm run lint:firefox",
    "dev:firefox": "npm run build && web-ext run --source-dir dist/firefox",
    "preview": "python3 -m http.server 8765 --bind 127.0.0.1 --directory src",
    "format": "prettier --write \"src/**/*.{js,html,css}\" \"tests/**/*.js\" \"manifests/*.json\" \"docs/*.md\" README.md package.json .github/workflows/check.yml"
  },
  "devDependencies": {
    "prettier": "3.9.10",
    "web-ext": "10.8.0"
  }
}
